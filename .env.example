# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file containing real secrets.

# --- Site ---
# Public canonical host. Read by src/config/site.ts (falls back to the
# previous apexhrllc.com domain when unset) — every canonical/OG/sitemap
# URL across the whole site, not only WordPress articles, derives from this.
NEXT_PUBLIC_SITE_URL=https://www.apexhrllc.co.uk

# --- WordPress (headless editorial CMS for Insights/blog content only —
# see docs/URL-DECISION-REGISTER.md and src/lib/wordpress/). Does not
# replace Sanity for any other content type or Supabase for operational
# data. WORDPRESS_SITE_URL is the CMS/API origin only, never a public
# canonical; public articles are served at NEXT_PUBLIC_SITE_URL/{slug}/. ---
WORDPRESS_API_URL=https://blog.apexhrllc.co.uk/wp-json/wp/v2
WORDPRESS_SITE_URL=https://blog.apexhrllc.co.uk

# --- Sanity (public editorial CMS for non-Insights content) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
SANITY_REVALIDATE_SECRET=

# --- Supabase (operational data: leads, candidates, applications, consent) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Resend) ---
RESEND_API_KEY=
TRANSACTIONAL_EMAIL_FROM=
INTERNAL_LEAD_NOTIFICATION_EMAIL=

# --- Spam protection (Cloudflare Turnstile) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Measurement ---
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Error monitoring (Sentry) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
