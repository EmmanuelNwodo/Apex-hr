# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file containing real secrets.

# --- Site ---
# Public canonical host. Read by src/config/site.ts (falls back to this
# same confirmed domain when unset, so a missing env var can no longer
# regress to the retired apexhrllc.com domain) — every canonical/OG/sitemap
# URL across the whole site, not only WordPress articles, derives from this.
# Must be set in the Vercel Production environment, not only .env.local —
# .env.local is git-ignored and never reaches a deployed build on its own.
NEXT_PUBLIC_SITE_URL=https://www.apexhrllc.co.uk

# --- WordPress (headless Insights/blog CMS plus the vacancy REST feed —
# see docs/URL-DECISION-REGISTER.md, docs/JOB-BOARD-SETUP.md and
# src/lib/wordpress/). The CMS origin is never a public canonical; public
# articles and vacancy pages are served at NEXT_PUBLIC_SITE_URL. ---
WORDPRESS_API_URL=https://blog.apexhrllc.co.uk/wp-json/wp/v2
WORDPRESS_SITE_URL=https://blog.apexhrllc.co.uk

# --- Private job-application submission integration (server only) ---
# Full HTTPS URL of the authenticated Apex HR WordPress REST endpoint.
WORDPRESS_APPLICATIONS_API_URL=
# Dedicated WordPress user assigned only the Apex HR Application Submitter role.
WORDPRESS_APPLICATIONS_USERNAME=
# Application Password generated for that integration user; never use the account password.
WORDPRESS_APPLICATIONS_APP_PASSWORD=

# --- Sanity (public editorial CMS for non-Insights content) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
SANITY_REVALIDATE_SECRET=

# --- Supabase (operational data: leads, candidates, applications, consent) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Resend) ---
RESEND_API_KEY=
TRANSACTIONAL_EMAIL_FROM=
INTERNAL_LEAD_NOTIFICATION_EMAIL=

# --- Spam protection (Cloudflare Turnstile) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Measurement ---
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Error monitoring (Sentry) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
